@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject PortfolioDataService PortfolioService
@inject IJSRuntime JS
@implements IDisposable

<div class="min-h-screen bg-[#05070B] text-slate-100 cyber-grid flex flex-col selection:bg-[#00F0FF]/30 selection:text-white">
    <!-- Floating Glass Navbar -->
    <header class="sticky top-0 z-50 w-full px-4 sm:px-8 py-4">
        <nav class="max-w-6xl mx-auto glass-panel rounded-2xl px-5 py-3.5 flex items-center justify-between border border-[#00F0FF]/20 shadow-[0_0_20px_rgba(0,240,255,0.08)]">
            <!-- Brand & Status Pill -->
            <a href="/" class="flex items-center space-x-3 group">
                <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-[#00F0FF] to-[#2563EB] p-[1.5px] shadow-[0_0_15px_rgba(0,240,255,0.4)]">
                    <div class="w-full h-full bg-[#05070B] rounded-[10px] flex items-center justify-center font-mono font-bold text-sm text-[#00F0FF]">
                        EJ
                    </div>
                </div>
                <div class="flex flex-col">
                    <span class="font-bold text-white text-sm tracking-wide font-sans group-hover:text-[#00F0FF] transition-colors">
                        Erick John
                    </span>
                    <span class="inline-flex items-center gap-1.5 text-[10px] font-mono text-[#00F0FF]">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#00F0FF] animate-ping"></span>
                        <span class="text-slate-400">Available</span>
                    </span>
                </div>
            </a>

            <!-- Nav Links -->
            <div class="hidden md:flex items-center space-x-7 text-sm font-medium text-slate-300">
                <a href="/#projects" class="hover:text-[#00F0FF] transition-colors">Projects</a>
                <a href="/#skills" class="hover:text-[#00F0FF] transition-colors">Tech Stack</a>
                <a href="/#timeline" class="hover:text-[#00F0FF] transition-colors">Experience</a>
                <a href="/#contact" class="hover:text-[#00F0FF] transition-colors">Contact</a>
            </div>

            <!-- Action Controls & Command Palette Button -->
            <div class="flex items-center space-x-3">
                <!-- Command Palette Shortcut Trigger -->
                <button @onclick="OpenPalette" title="Open Command Palette (Ctrl+K)"
                        class="hidden sm:flex items-center space-x-2 px-3 py-1.5 rounded-xl bg-[#111A2E] border border-[#00F0FF]/20 text-slate-400 hover:text-[#00F0FF] hover:border-[#00F0FF]/50 text-xs font-mono transition-all">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                    <span>Search</span>
                    <kbd class="px-1.5 py-0.5 rounded bg-[#05070B] border border-[#00F0FF]/30 text-[10px] text-[#00F0FF]">⌘K</kbd>
                </button>

                <a href="/#contact" class="hidden lg:inline-flex items-center px-4 py-2 rounded-xl text-xs font-mono font-semibold bg-[#00F0FF] text-[#05070B] hover:bg-[#00F0FF]/90 transition-all shadow-[0_0_15px_rgba(0,240,255,0.3)]">
                    Let's Connect
                </a>

                <AuthorizeView>
                    <Authorized>
                        <a href="/admin" class="flex items-center space-x-1.5 px-3 py-1.5 rounded-lg border border-[#00F0FF]/40 bg-[#111A2E] text-[#00F0FF] text-xs font-mono hover:bg-[#00F0FF]/20 transition-all">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                            </svg>
                            <span>Admin</span>
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" title="Admin Sign In" class="p-2 rounded-lg text-slate-400 hover:text-[#00F0FF] hover:bg-[#111A2E] transition-all border border-transparent hover:border-[#00F0FF]/20">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </nav>
    </header>

    <!-- Main View Content -->
    <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-8 py-6">
        @Body
    </main>

    <!-- Futuristic Cyber Footer -->
    <footer class="w-full border-t border-[#00F0FF]/15 bg-[#0A0F1D]/60 mt-16 py-8 px-4 sm:px-8 backdrop-blur-md">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-xs font-mono text-slate-400">
            <div class="flex items-center space-x-2">
                <span class="text-[#00F0FF]">© @DateTime.UtcNow.Year Erick John</span>
                <span>•</span>
                <span>Spec-Driven Blazor WASM</span>
            </div>

            <div class="flex items-center space-x-4">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-[#111A2E] border border-[#00F0FF]/30 text-[#00F0FF] text-[11px]">
                    .NET 10 + Supabase RLS
                </span>
                <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#00F0FF] transition-colors">GitHub</a>
                <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="hover:text-[#00F0FF] transition-colors">LinkedIn</a>
            </div>
        </div>
    </footer>
</div>

<!-- ========================================== -->
<!-- CYBER COMMAND PALETTE MODAL (Ctrl + K)     -->
<!-- ========================================== -->
@if (isPaletteOpen)
{
    <div class="fixed inset-0 z-[100] flex items-start justify-center pt-20 px-4 bg-black/75 backdrop-blur-md" @onclick="ClosePalette">
        <div class="glass-panel w-full max-w-xl rounded-2xl border border-[#00F0FF]/50 shadow-[0_0_50px_rgba(0,240,255,0.25)] overflow-hidden" @onclick:stopPropagation="true">
            <!-- Search Input Header -->
            <div class="p-4 border-b border-[#00F0FF]/20 flex items-center space-x-3 bg-[#0A0F1D]/90">
                <svg class="w-5 h-5 text-[#00F0FF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                <input @bind="searchQuery" @bind:event="oninput" autofocus
                       placeholder="Type a command or search projects..."
                       class="w-full bg-transparent text-white font-mono text-sm placeholder:text-slate-500 focus:outline-none" />
                <button @onclick="ClosePalette" class="px-2 py-0.5 rounded bg-[#111A2E] border border-[#00F0FF]/30 text-[10px] font-mono text-slate-400 hover:text-white">
                    ESC
                </button>
            </div>

            <!-- Command Results List -->
            <div class="max-h-80 overflow-y-auto p-2 font-mono text-xs space-y-1">
                <!-- Navigation Commands -->
                <div class="px-3 py-1.5 text-[10px] text-[#00F0FF] uppercase tracking-wider font-semibold">
                    Navigation Nodes
                </div>

                <button @onclick="@(() => NavigateAndClose("/#projects"))" class="w-full flex items-center justify-between p-2.5 rounded-xl hover:bg-[#111A2E] hover:text-[#00F0FF] transition-colors text-slate-300 text-left">
                    <span class="flex items-center space-x-2">
                        <span class="text-[#00F0FF]">→</span>
                        <span>Explore Projects & Case Studies</span>
                    </span>
                    <span class="text-[10px] text-slate-500">#projects</span>
                </button>

                <button @onclick="@(() => NavigateAndClose("/#skills"))" class="w-full flex items-center justify-between p-2.5 rounded-xl hover:bg-[#111A2E] hover:text-[#00F0FF] transition-colors text-slate-300 text-left">
                    <span class="flex items-center space-x-2">
                        <span class="text-[#00F0FF]">→</span>
                        <span>Technical Arsenal & Skills Stack</span>
                    </span>
                    <span class="text-[10px] text-slate-500">#skills</span>
                </button>

                <button @onclick="@(() => NavigateAndClose("/#timeline"))" class="w-full flex items-center justify-between p-2.5 rounded-xl hover:bg-[#111A2E] hover:text-[#00F0FF] transition-colors text-slate-300 text-left">
                    <span class="flex items-center space-x-2">
                        <span class="text-[#00F0FF]">→</span>
                        <span>Career Timeline & Experience</span>
                    </span>
                    <span class="text-[10px] text-slate-500">#timeline</span>
                </button>

                <button @onclick="@(() => NavigateAndClose("/#contact"))" class="w-full flex items-center justify-between p-2.5 rounded-xl hover:bg-[#111A2E] hover:text-[#00F0FF] transition-colors text-slate-300 text-left">
                    <span class="flex items-center space-x-2">
                        <span class="text-[#00F0FF]">→</span>
                        <span>Send Transmission / Contact</span>
                    </span>
                    <span class="text-[10px] text-slate-500">#contact</span>
                </button>

                <!-- Project Search Matches -->
                @if (filteredPaletteProjects.Count > 0)
                {
                    <div class="px-3 pt-3 pb-1.5 text-[10px] text-[#00F0FF] uppercase tracking-wider font-semibold border-t border-[#00F0FF]/15 mt-2">
                        Matching Projects (@filteredPaletteProjects.Count)
                    </div>
                    @foreach (var proj in filteredPaletteProjects)
                    {
                        <button @onclick="@(() => NavigateAndClose($"/projects/{proj.Slug}"))" class="w-full flex items-center justify-between p-2.5 rounded-xl hover:bg-[#111A2E] hover:text-[#00F0FF] transition-colors text-slate-300 text-left">
                            <span class="font-sans font-semibold text-white">@proj.Title</span>
                            <span class="text-[10px] text-[#00F0FF]">Case Study →</span>
                        </button>
                    }
                }

                <!-- Admin & Management -->
                <div class="px-3 pt-3 pb-1.5 text-[10px] text-[#00F0FF] uppercase tracking-wider font-semibold border-t border-[#00F0FF]/15 mt-2">
                    Control Plane
                </div>

                <button @onclick="@(() => NavigateAndClose("/admin"))" class="w-full flex items-center justify-between p-2.5 rounded-xl hover:bg-[#111A2E] hover:text-[#00F0FF] transition-colors text-slate-300 text-left">
                    <span class="flex items-center space-x-2">
                        <span class="text-[#00F0FF]">⚙</span>
                        <span>Admin Control Center</span>
                    </span>
                    <span class="text-[10px] text-slate-500">/admin</span>
                </button>
            </div>

            <!-- Palette Footer -->
            <div class="p-3 bg-[#05070B] border-t border-[#00F0FF]/15 flex items-center justify-between text-[11px] font-mono text-slate-500">
                <span>Select with click or enter</span>
                <span>Antigravity Spec-Driven WASM</span>
            </div>
        </div>
    </div>
}

@code {
    private bool isPaletteOpen = false;
    private string searchQuery = string.Empty;
    private List<ProjectItem> cachedProjects = new();
    private DotNetObjectReference<MainLayout>? objRef;

    private List<ProjectItem> filteredPaletteProjects =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? cachedProjects.Take(3).ToList()
            : cachedProjects.Where(p => p.Title.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                       p.TechTags.Any(t => t.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))).ToList();

    protected override async Task OnInitializedAsync()
    {
        cachedProjects = await PortfolioService.GetProjectsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                objRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("registerCommandPaletteShortcut", objRef);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Command palette JS notice: {ex.Message}");
            }
        }
    }

    [JSInvokable]
    public void ToggleCommandPalette()
    {
        isPaletteOpen = !isPaletteOpen;
        searchQuery = string.Empty;
        StateHasChanged();
    }

    [JSInvokable]
    public void CloseCommandPalette()
    {
        if (isPaletteOpen)
        {
            isPaletteOpen = false;
            StateHasChanged();
        }
    }

    private void OpenPalette()
    {
        isPaletteOpen = true;
        searchQuery = string.Empty;
    }

    private void ClosePalette()
    {
        isPaletteOpen = false;
    }

    private void NavigateAndClose(string uri)
    {
        isPaletteOpen = false;
        Navigation.NavigateTo(uri);
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }
}
