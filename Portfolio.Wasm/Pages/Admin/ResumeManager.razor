@page "/admin/resume"
@layout AdminLayout
@attribute [Authorize]
@inject PortfolioDataService PortfolioService
@inject StorageService Storage
@inject NavigationManager Navigation

<PageTitle>Resume & CV Manager | Admin</PageTitle>

<div class="max-w-5xl space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold text-white font-sans">Resume & CV Management</h1>
            <p class="text-xs font-mono text-[#00F0FF]">UPLOAD, MANAGE & PREVIEW PORTFOLIO RESUME PDF</p>
        </div>
        
        <div class="flex items-center space-x-3">
            @if (savedNotification)
            {
                <div class="px-3 py-1.5 rounded-lg bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 font-mono text-xs">
                    ✓ Resume updated successfully!
                </div>
            }
            <a href="/#resume" target="_blank" class="px-4 py-2 rounded-xl bg-[#111A2E] border border-[#00F0FF]/30 text-[#00F0FF] hover:bg-[#00F0FF]/10 text-xs font-mono flex items-center space-x-2 transition-all">
                <span>View Public Section</span>
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
            </a>
        </div>
    </div>

    @if (profile == null)
    {
        <div class="py-16 text-center text-slate-400 font-mono text-xs">
            <div class="inline-block w-6 h-6 border-2 border-[#00F0FF] border-t-transparent rounded-full animate-spin mb-3"></div>
            <div>LOADING RESUME DATA...</div>
        </div>
    }
    else
    {
        <!-- Upload & Settings Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left 2 Cols: Uploader & Metadata -->
            <div class="lg:col-span-1 space-y-6">
                <!-- Upload Box -->
                <div class="glass-panel p-6 rounded-2xl border border-[#00F0FF]/25 shadow-[0_0_25px_rgba(0,240,255,0.08)]">
                    <h2 class="text-sm font-bold font-mono text-white mb-1 flex items-center space-x-2">
                        <svg class="w-4 h-4 text-[#00F0FF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
                        </svg>
                        <span>UPLOAD NEW PDF</span>
                    </h2>
                    <p class="text-xs text-slate-400 mb-4">Accepts PDF documents up to 15 MB. Replaces active portfolio resume immediately.</p>

                    <div class="border-2 border-dashed border-[#00F0FF]/30 hover:border-[#00F0FF] rounded-2xl p-6 text-center bg-[#05070B]/60 transition-all group">
                        <InputFile OnChange="HandlePdfUpload" accept=".pdf,application/pdf" id="pdfFileInput" class="hidden" />
                        <label for="pdfFileInput" class="cursor-pointer block">
                            <div class="w-12 h-12 mx-auto mb-3 rounded-xl bg-[#111A2E] border border-[#00F0FF]/30 flex items-center justify-center text-[#00F0FF] group-hover:scale-110 transition-transform shadow-[0_0_15px_rgba(0,240,255,0.2)]">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                            </div>
                            <span class="text-xs font-mono text-[#00F0FF] font-semibold block mb-1">Click to select PDF</span>
                            <span class="text-[11px] font-mono text-slate-500 block">or drag & drop here</span>
                        </label>
                    </div>

                    @if (isUploading)
                    {
                        <div class="mt-4 p-3 rounded-xl bg-[#111A2E] border border-[#00F0FF]/30 flex items-center space-x-3 text-xs font-mono text-[#00F0FF]">
                            <div class="w-4 h-4 border-2 border-[#00F0FF] border-t-transparent rounded-full animate-spin"></div>
                            <span>Processing & uploading PDF...</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(uploadErrorMessage))
                    {
                        <div class="mt-4 p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-xs font-mono text-red-400">
                            @uploadErrorMessage
                        </div>
                    }
                </div>

                <!-- URL & Manual Config Box -->
                <div class="glass-panel p-6 rounded-2xl border border-[#00F0FF]/25 shadow-[0_0_25px_rgba(0,240,255,0.08)] space-y-4">
                    <h2 class="text-sm font-bold font-mono text-white flex items-center space-x-2">
                        <svg class="w-4 h-4 text-[#00F0FF]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                        </svg>
                        <span>RESUME LOCATION</span>
                    </h2>

                    <div>
                        <label class="block text-[11px] font-mono text-slate-400 mb-1">FILE URL OR STORAGE PATH</label>
                        <input @bind="profile.ResumeUrl" @bind:event="oninput"
                               placeholder="e.g. documents/Erick_John_Resume.pdf"
                               class="w-full px-3.5 py-2 rounded-xl bg-[#111A2E] text-white border border-[#00F0FF]/25 focus:border-[#00F0FF] focus:outline-none text-xs font-mono" />
                    </div>

                    <div class="flex flex-wrap gap-2 pt-1">
                        <button type="button" @onclick="SetDefaultResume" class="px-3 py-1.5 rounded-lg bg-[#111A2E] border border-slate-700 hover:border-[#00F0FF]/50 text-slate-300 hover:text-white text-[11px] font-mono transition-colors">
                            Reset to Default PDF
                        </button>
                    </div>

                    <div class="pt-2">
                        <button @onclick="SaveResume" disabled="@isSaving"
                                class="w-full py-2.5 rounded-xl bg-[#00F0FF] text-[#05070B] font-bold font-mono text-xs hover:bg-[#00F0FF]/90 transition-all shadow-[0_0_15px_rgba(0,240,255,0.3)] disabled:opacity-50">
                            @(isSaving ? "SAVING..." : "SAVE RESUME SETTINGS")
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right 2 Cols: Live Preview -->
            <div class="lg:col-span-2 space-y-4">
                <div class="glass-panel p-4 sm:p-6 rounded-2xl border border-[#00F0FF]/30 shadow-[0_0_35px_rgba(0,240,255,0.12)]">
                    <div class="flex items-center justify-between pb-4 border-b border-[#00F0FF]/20 mb-4">
                        <div class="flex items-center space-x-2">
                            <span class="w-3 h-3 rounded-full bg-red-500/80"></span>
                            <span class="w-3 h-3 rounded-full bg-yellow-500/80"></span>
                            <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
                            <span class="ml-2 font-mono text-xs text-[#00F0FF] font-semibold">LIVE PDF PREVIEW</span>
                        </div>

                        <div class="flex items-center space-x-3 text-xs font-mono">
                            @if (!string.IsNullOrEmpty(profile.ResumeUrl) && profile.ResumeUrl != "#")
                            {
                                <a href="@profile.ResumeUrl" download="Erick_John_Resume.pdf" class="px-3 py-1.5 rounded-lg bg-[#111A2E] text-slate-200 border border-[#00F0FF]/30 hover:border-[#00F0FF] hover:text-[#00F0FF] flex items-center space-x-1.5 transition-all">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                                    </svg>
                                    <span>Download</span>
                                </a>

                                <a href="@profile.ResumeUrl" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 rounded-lg bg-[#00F0FF] text-[#05070B] font-bold hover:bg-[#00F0FF]/90 flex items-center space-x-1.5 transition-all shadow-[0_0_10px_rgba(0,240,255,0.3)]">
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                    </svg>
                                    <span>Open In New Tab</span>
                                </a>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(profile.ResumeUrl) && profile.ResumeUrl != "#")
                    {
                        <div class="w-full h-[650px] rounded-xl overflow-hidden bg-[#05070B] border border-[#00F0FF]/20 relative">
                            <object data="@profile.ResumeUrl" type="application/pdf" class="w-full h-full">
                                <iframe src="@profile.ResumeUrl" class="w-full h-full border-0" title="Resume PDF Preview">
                                    <div class="h-full flex flex-col items-center justify-center p-8 text-center text-slate-400 font-mono text-xs">
                                        <p class="mb-4">Inline PDF display not supported in this embedded browser view.</p>
                                        <a href="@profile.ResumeUrl" target="_blank" class="px-4 py-2 rounded-xl bg-[#00F0FF] text-[#05070B] font-bold">
                                            Open PDF Directly
                                        </a>
                                    </div>
                                </iframe>
                            </object>
                        </div>
                    }
                    else
                    {
                        <div class="h-96 rounded-xl border border-dashed border-[#00F0FF]/25 flex flex-col items-center justify-center text-center p-8 bg-[#05070B]/50 font-mono">
                            <div class="w-16 h-16 rounded-2xl bg-[#111A2E] border border-[#00F0FF]/30 flex items-center justify-center text-slate-500 mb-3">
                                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                            </div>
                            <span class="text-sm text-slate-300 font-semibold mb-1">No Resume PDF Configured</span>
                            <p class="text-xs text-slate-500 max-w-sm">Upload a PDF resume from the upload box on the left to activate preview and public portfolio downloads.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private ProfileSettings? profile;
    private bool isSaving;
    private bool isUploading;
    private bool savedNotification;
    private string? uploadErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        profile = await PortfolioService.GetProfileAsync();
    }

    private async Task HandlePdfUpload(InputFileChangeEventArgs e)
    {
        if (profile == null) return;
        uploadErrorMessage = null;

        var file = e.File;
        if (file == null) return;

        // Validation
        if (!file.Name.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) && 
            file.ContentType != "application/pdf")
        {
            uploadErrorMessage = "Invalid file type. Please upload a valid PDF document (.pdf).";
            return;
        }

        if (file.Size > 15 * 1024 * 1024)
        {
            uploadErrorMessage = "File size exceeds 15 MB limit.";
            return;
        }

        isUploading = true;
        try
        {
            var uploadedUrl = await Storage.UploadPdfAsync(file, "resumes");
            profile.ResumeUrl = uploadedUrl;
            
            // Auto save profile with the new resume URL
            await PortfolioService.SaveProfileAsync(profile);
            savedNotification = true;
            _ = Task.Delay(3000).ContinueWith(_ => { savedNotification = false; InvokeAsync(StateHasChanged); });
        }
        catch (Exception ex)
        {
            uploadErrorMessage = $"Upload failed: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private void SetDefaultResume()
    {
        if (profile == null) return;
        profile.ResumeUrl = "documents/Erick_John_Resume.pdf";
    }

    private async Task SaveResume()
    {
        if (profile == null) return;
        isSaving = true;
        try
        {
            await PortfolioService.SaveProfileAsync(profile);
            savedNotification = true;
            _ = Task.Delay(3000).ContinueWith(_ => { savedNotification = false; InvokeAsync(StateHasChanged); });
        }
        finally
        {
            isSaving = false;
        }
    }
}
