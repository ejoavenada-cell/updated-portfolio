@page "/admin/profile"
@layout AdminLayout
@attribute [Authorize]
@inject PortfolioDataService PortfolioService
@inject StorageService Storage

<PageTitle>Profile Editor | Admin</PageTitle>

<div class="max-w-4xl space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-white font-sans">Profile & Bio Editor</h1>
            <p class="text-xs font-mono text-[#00F0FF]">LIVE SYNCHRONIZATION WITH SUPABASE</p>
        </div>
        @if (savedNotification)
        {
            <div class="px-3 py-1.5 rounded-lg bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 font-mono text-xs">
                ✓ Changes saved successfully!
            </div>
        }
    </div>

    @if (profile == null)
    {
        <div class="py-12 text-center text-slate-400 font-mono text-xs">LOADING PROFILE...</div>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Form -->
            <div class="lg:col-span-2 glass-panel p-6 sm:p-8 rounded-2xl border border-[#00F0FF]/20 space-y-4">
                <div>
                    <label class="block text-xs font-mono text-slate-300 mb-1">FULL NAME</label>
                    <input @bind="profile.FullName" class="w-full px-4 py-2.5 rounded-xl bg-[#111A2E] text-white border border-[#00F0FF]/25 focus:border-[#00F0FF] focus:outline-none text-sm font-mono" />
                </div>

                <div>
                    <label class="block text-xs font-mono text-slate-300 mb-1">HEADLINE</label>
                    <input @bind="profile.Headline" class="w-full px-4 py-2.5 rounded-xl bg-[#111A2E] text-white border border-[#00F0FF]/25 focus:border-[#00F0FF] focus:outline-none text-sm font-mono" />
                </div>

                <div>
                    <label class="block text-xs font-mono text-slate-300 mb-1">AVAILABILITY STATUS BADGE</label>
                    <input @bind="profile.StatusText" class="w-full px-4 py-2.5 rounded-xl bg-[#111A2E] text-white border border-[#00F0FF]/25 focus:border-[#00F0FF] focus:outline-none text-sm font-mono" />
                </div>

                <div>
                    <label class="block text-xs font-mono text-slate-300 mb-1">BIOGRAPHY</label>
                    <textarea @bind="profile.Bio" rows="4" class="w-full px-4 py-2.5 rounded-xl bg-[#111A2E] text-white border border-[#00F0FF]/25 focus:border-[#00F0FF] focus:outline-none text-sm font-mono"></textarea>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-mono text-slate-300 mb-1">EMAIL ADDRESS</label>
                        <input @bind="profile.EmailAddress" class="w-full px-4 py-2.5 rounded-xl bg-[#111A2E] text-white border border-[#00F0FF]/25 focus:border-[#00F0FF] focus:outline-none text-sm font-mono" />
                    </div>

                    <div>
                        <label class="block text-xs font-mono text-slate-300 mb-1">RESUME URL / FILE LINK</label>
                        <input @bind="profile.ResumeUrl" class="w-full px-4 py-2.5 rounded-xl bg-[#111A2E] text-white border border-[#00F0FF]/25 focus:border-[#00F0FF] focus:outline-none text-sm font-mono" />
                    </div>

                    <div>
                        <label class="block text-xs font-mono text-slate-300 mb-1">GITHUB PROFILE URL</label>
                        <input @bind="profile.GithubUrl" class="w-full px-4 py-2.5 rounded-xl bg-[#111A2E] text-white border border-[#00F0FF]/25 focus:border-[#00F0FF] focus:outline-none text-sm font-mono" />
                    </div>

                    <div>
                        <label class="block text-xs font-mono text-slate-300 mb-1">LINKEDIN PROFILE URL</label>
                        <input @bind="profile.LinkedinUrl" class="w-full px-4 py-2.5 rounded-xl bg-[#111A2E] text-white border border-[#00F0FF]/25 focus:border-[#00F0FF] focus:outline-none text-sm font-mono" />
                    </div>
                </div>

                <!-- Avatar Upload -->
                <div class="pt-2 border-t border-[#00F0FF]/15">
                    <label class="block text-xs font-mono text-slate-300 mb-2">UPDATE AVATAR (OPTIMIZED TO WEBP)</label>
                    <InputFile OnChange="HandleAvatarUpload" class="text-xs font-mono text-slate-400 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-[#00F0FF] file:text-[#05070B] hover:file:bg-[#00F0FF]/90 cursor-pointer" />
                    @if (isUploading)
                    {
                        <span class="inline-block mt-2 text-xs font-mono text-[#00F0FF]">Resizing & uploading WebP...</span>
                    }
                </div>

                <div class="pt-4">
                    <button @onclick="SaveProfile" disabled="@isSaving"
                            class="px-6 py-2.5 rounded-xl bg-[#00F0FF] text-[#05070B] font-bold font-mono text-xs hover:bg-[#00F0FF]/90 transition-all shadow-[0_0_15px_rgba(0,240,255,0.3)] disabled:opacity-50">
                        @(isSaving ? "SAVING..." : "COMMIT CHANGES")
                    </button>
                </div>
            </div>

            <!-- Live Preview -->
            <div class="glass-panel p-6 rounded-2xl border border-[#00F0FF]/20 text-center flex flex-col items-center justify-center">
                <span class="text-xs font-mono text-[#00F0FF] mb-4">LIVE PREVIEW</span>
                <div class="w-32 h-32 rounded-2xl p-1 bg-gradient-to-tr from-[#00F0FF] to-[#2563EB] mb-4 shadow-[0_0_20px_rgba(0,240,255,0.3)]">
                    <div class="w-full h-full bg-[#05070B] rounded-[14px] overflow-hidden">
                        @if (!string.IsNullOrEmpty(profile.AvatarUrl))
                        {
                            <img src="@profile.AvatarUrl" alt="Avatar" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center font-mono font-bold text-2xl text-[#00F0FF]">
                                EJ
                            </div>
                        }
                    </div>
                </div>
                <h3 class="font-bold text-white text-base">@profile.FullName</h3>
                <p class="text-xs font-mono text-[#00F0FF] mt-1">@profile.Headline</p>
                <div class="mt-3 px-2.5 py-1 rounded-full bg-[#111A2E] text-[10px] font-mono text-slate-300 border border-[#00F0FF]/20">
                    @profile.StatusText
                </div>
            </div>
        </div>
    }
</div>

@code {
    private ProfileSettings? profile;
    private bool isSaving;
    private bool isUploading;
    private bool savedNotification;

    protected override async Task OnInitializedAsync()
    {
        profile = await PortfolioService.GetProfileAsync();
    }

    private async Task HandleAvatarUpload(InputFileChangeEventArgs e)
    {
        if (profile == null) return;
        isUploading = true;
        try
        {
            var url = await Storage.UploadImageAsync(e.File, "avatars");
            profile.AvatarUrl = url;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Upload error: {ex.Message}");
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task SaveProfile()
    {
        if (profile == null) return;
        isSaving = true;
        try
        {
            await PortfolioService.SaveProfileAsync(profile);
            savedNotification = true;
            await Task.Delay(3000);
            savedNotification = false;
        }
        finally
        {
            isSaving = false;
        }
    }
}
