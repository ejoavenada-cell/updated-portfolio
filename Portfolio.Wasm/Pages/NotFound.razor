@page "/not-found"
@layout MainLayout

<PageTitle>404 // Node Not Found</PageTitle>

<div class="py-20 text-center max-w-lg mx-auto">
    <div class="glass-panel p-10 rounded-3xl border border-[#00F0FF]/30 shadow-[0_0_40px_rgba(0,240,255,0.12)]">
        <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-[#111A2E] border border-[#00F0FF]/40 flex items-center justify-center font-mono font-bold text-2xl text-[#00F0FF] shadow-[0_0_20px_rgba(0,240,255,0.3)]">
            404
        </div>
        <h1 class="text-2xl font-bold font-sans text-white mb-2">VECTOR NOT FOUND</h1>
        <p class="text-slate-400 text-sm mb-6 font-sans">
            The requested resource node does not exist or has been relocated within the network.
        </p>
        <a href="/" class="inline-flex items-center space-x-2 px-6 py-2.5 rounded-xl bg-[#00F0FF] text-[#05070B] font-mono text-xs font-bold hover:bg-[#00F0FF]/90 transition-all shadow-[0_0_15px_rgba(0,240,255,0.3)]">
            <span>Return to Base</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
        </a>
    </div>
</div>
