@page "/"
@inject PortfolioDataService PortfolioService
@inject NavigationManager Navigation

<PageTitle>@(profile?.FullName ?? "Erick John") | .NET 10 & Blazor Software Engineer</PageTitle>

@if (isLoading)
{
    <div class="py-24 text-center">
        <div class="inline-block w-8 h-8 border-2 border-[#00F0FF] border-t-transparent rounded-full animate-spin"></div>
        <p class="mt-4 font-mono text-xs text-slate-400">LOADING PORTFOLIO DATA...</p>
    </div>
}
else
{
    <!-- ========================================== -->
    <!-- HERO SECTION                               -->
    <!-- ========================================== -->
    <section class="pt-6 pb-20 relative">
        <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-96 h-96 bg-[#00F0FF]/10 blur-[120px] rounded-full pointer-events-none"></div>
        
        <div class="glass-panel rounded-3xl p-8 md:p-14 border border-[#00F0FF]/25 shadow-[0_0_40px_rgba(0,240,255,0.1)] relative overflow-hidden">
            <div class="flex flex-col-reverse lg:flex-row items-center justify-between gap-10">
                <div class="flex-1 text-center lg:text-left">
                    <!-- Status Badge -->
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#111A2E] border border-[#00F0FF]/40 text-[#00F0FF] font-mono text-xs mb-6 shadow-[0_0_15px_rgba(0,240,255,0.2)]">
                        <span class="w-2 h-2 rounded-full bg-[#00F0FF] animate-pulse"></span>
                        <span>@(profile?.StatusText ?? "Available for Opportunities")</span>
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-tight font-sans">
                        Hi, I'm <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00F0FF] via-[#38bdf8] to-[#2563EB]">@(profile?.FullName ?? "Erick John")</span>
                    </h1>

                    <p class="mt-4 text-xl sm:text-2xl font-mono text-[#00F0FF]/90 font-medium">
                        @(profile?.Headline ?? ".NET & Full-Stack Software Developer")
                    </p>

                    <p class="mt-5 text-slate-400 max-w-2xl text-base sm:text-lg leading-relaxed">
                        @(profile?.Bio ?? "Building modern, high-performance web applications with Blazor and .NET.")
                    </p>

                    <!-- CTAs & Social Links -->
                    <div class="mt-8 flex flex-wrap items-center justify-center lg:justify-start gap-4 font-mono text-sm">
                        <a href="#projects" class="px-6 py-3 rounded-xl bg-[#00F0FF] text-[#05070B] font-bold hover:bg-[#00F0FF]/90 transition-all shadow-[0_0_20px_rgba(0,240,255,0.4)] flex items-center space-x-2">
                            <span>Explore Projects</span>
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                            </svg>
                        </a>

                        @if (!string.IsNullOrEmpty(profile?.ResumeUrl) && profile.ResumeUrl != "#")
                        {
                            <a href="@profile.ResumeUrl" target="_blank" rel="noopener noreferrer" class="px-5 py-3 rounded-xl bg-[#111A2E] text-slate-200 border border-[#00F0FF]/30 hover:border-[#00F0FF] hover:text-[#00F0FF] transition-all flex items-center space-x-2">
                                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                </svg>
                                <span>Get Resume</span>
                            </a>
                        }

                        @if (!string.IsNullOrEmpty(profile?.GithubUrl))
                        {
                            <a href="@profile.GithubUrl" target="_blank" rel="noopener noreferrer" class="p-3 rounded-xl bg-[#111A2E] text-slate-300 border border-[#00F0FF]/20 hover:border-[#00F0FF] hover:text-[#00F0FF] transition-all" title="GitHub">
                                <svg class="w-5 h-5 fill-currentColor" viewBox="0 0 24 24">
                                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                                </svg>
                            </a>
                        }

                        @if (!string.IsNullOrEmpty(profile?.LinkedinUrl))
                        {
                            <a href="@profile.LinkedinUrl" target="_blank" rel="noopener noreferrer" class="p-3 rounded-xl bg-[#111A2E] text-slate-300 border border-[#00F0FF]/20 hover:border-[#00F0FF] hover:text-[#00F0FF] transition-all" title="LinkedIn">
                                <svg class="w-5 h-5 fill-currentColor" viewBox="0 0 24 24">
                                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                                </svg>
                            </a>
                        }
                    </div>
                </div>

                <!-- Hero Avatar Card -->
                <div class="relative group">
                    <div class="w-52 h-52 sm:w-64 sm:h-64 rounded-3xl p-1 bg-gradient-to-tr from-[#00F0FF] via-[#2563EB] to-cyan-400 shadow-[0_0_35px_rgba(0,240,255,0.35)] group-hover:shadow-[0_0_50px_rgba(0,240,255,0.6)] transition-all duration-500">
                        <div class="w-full h-full bg-[#05070B] rounded-[22px] overflow-hidden">
                            @if (!string.IsNullOrEmpty(profile?.AvatarUrl))
                            {
                                <img src="@profile.AvatarUrl" alt="@profile?.FullName" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                            }
                            else
                            {
                                <div class="w-full h-full flex flex-col items-center justify-center font-mono text-[#00F0FF] bg-[#0A0F1D]">
                                    <span class="text-5xl font-bold">EJ</span>
                                    <span class="text-xs text-slate-500 mt-2">.NET 10</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========================================== -->
    <!-- BENTO TECH STACK GRID                      -->
    <!-- ========================================== -->
    <section id="skills" class="py-16">
        <div class="flex items-center justify-between mb-8">
            <div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-sans tracking-tight">
                    Technical Arsenal
                </h2>
                <p class="text-sm font-mono text-slate-400 mt-1">CORE PROFICIENCIES & PRODUCTION TOOLS</p>
            </div>
            <div class="hidden sm:block text-xs font-mono text-[#00F0FF] px-3 py-1 rounded-full border border-[#00F0FF]/30 bg-[#111A2E]">
                C# 13 • BLOR WASM
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
            @foreach (var category in new[] { "Backend", "Frontend", "Tools" })
            {
                var categorySkills = skills.Where(s => s.Category == category).OrderBy(s => s.DisplayOrder).ToList();
                <div class="glass-panel rounded-2xl p-6 border border-[#00F0FF]/20 flex flex-col justify-between">
                    <div>
                        <div class="flex items-center space-x-2 text-[#00F0FF] font-mono text-sm font-semibold mb-4 border-b border-[#00F0FF]/15 pb-2">
                            <span class="w-2 h-2 rounded-full bg-[#00F0FF]"></span>
                            <span>@category.ToUpperInvariant()</span>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @foreach (var skill in categorySkills)
                            {
                                <div class="px-3 py-1.5 rounded-lg bg-[#111A2E] text-slate-200 border border-[#00F0FF]/20 text-xs font-mono hover:border-[#00F0FF] hover:text-[#00F0FF] transition-all">
                                    @skill.Name
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ========================================== -->
    <!-- FILTERABLE PROJECTS SHOWCASE               -->
    <!-- ========================================== -->
    <section id="projects" class="py-16">
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
            <div>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-sans tracking-tight">
                    Featured Systems & Case Studies
                </h2>
                <p class="text-sm font-mono text-slate-400 mt-1">REAL-WORLD APPLICATIONS WITH LIVE ARCHITECTURE</p>
            </div>

            <!-- Filter Pills -->
            <div class="flex flex-wrap gap-2 font-mono text-xs">
                <button @onclick="@(() => selectedTag = null)"
                        class="px-3 py-1.5 rounded-xl border transition-all @(selectedTag == null ? "bg-[#00F0FF] text-[#05070B] font-bold border-[#00F0FF]" : "bg-[#111A2E] text-slate-400 border-[#00F0FF]/20 hover:text-white")">
                    All
                </button>
                @foreach (var tag in allTags)
                {
                    <button @onclick="@(() => selectedTag = tag)"
                            class="px-3 py-1.5 rounded-xl border transition-all @(selectedTag == tag ? "bg-[#00F0FF] text-[#05070B] font-bold border-[#00F0FF]" : "bg-[#111A2E] text-slate-400 border-[#00F0FF]/20 hover:text-white")">
                        @tag
                    </button>
                }
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @foreach (var project in FilteredProjects)
            {
                <div class="glass-panel rounded-2xl overflow-hidden border border-[#00F0FF]/20 hover:border-[#00F0FF]/60 hover:shadow-[0_0_25px_rgba(0,240,255,0.2)] transition-all flex flex-col group">
                    <!-- Project Thumbnail -->
                    <div class="h-48 w-full bg-[#111A2E] overflow-hidden relative">
                        @if (!string.IsNullOrEmpty(project.ThumbnailUrl))
                        {
                            <img src="@project.ThumbnailUrl" alt="@project.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center font-mono text-sm text-[#00F0FF]/40">
                                [ NO THUMBNAIL ]
                            </div>
                        }

                        @if (project.IsFeatured)
                        {
                            <div class="absolute top-3 right-3 px-2.5 py-1 rounded-md bg-[#05070B]/80 backdrop-blur-md border border-[#00F0FF]/50 text-[#00F0FF] text-[10px] font-mono uppercase font-semibold">
                                Featured
                            </div>
                        }
                    </div>

                    <!-- Content -->
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div>
                            <div class="flex flex-wrap gap-1.5 mb-3">
                                @foreach (var tag in project.TechTags.Take(3))
                                {
                                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-[#111A2E] text-[#00F0FF] border border-[#00F0FF]/20">
                                        @tag
                                    </span>
                                }
                            </div>

                            <h3 class="text-xl font-bold text-white group-hover:text-[#00F0FF] transition-colors font-sans mb-2">
                                @project.Title
                            </h3>

                            <p class="text-slate-400 text-xs sm:text-sm line-clamp-3 leading-relaxed mb-4">
                                @project.Summary
                            </p>
                        </div>

                        <!-- Action Links -->
                        <div class="pt-4 border-t border-[#00F0FF]/15 flex items-center justify-between font-mono text-xs">
                            <a href="/projects/@project.Slug" class="inline-flex items-center space-x-1.5 text-[#00F0FF] hover:underline font-semibold">
                                <span>Case Study</span>
                                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>

                            <div class="flex items-center space-x-3 text-slate-400">
                                @if (!string.IsNullOrEmpty(project.RepoUrl))
                                {
                                    <a href="@project.RepoUrl" target="_blank" rel="noopener noreferrer" class="hover:text-[#00F0FF]" title="Code Repository">
                                        <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24">
                                            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                                        </svg>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(project.LiveUrl))
                                {
                                    <a href="@project.LiveUrl" target="_blank" rel="noopener noreferrer" class="hover:text-[#00F0FF]" title="Live Preview">
                                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                        </svg>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ========================================== -->
    <!-- CAREER & EXPERIENCE TIMELINE               -->
    <!-- ========================================== -->
    <section id="timeline" class="py-16">
        <div class="mb-10">
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white font-sans tracking-tight">
                Career Progression & Track Record
            </h2>
            <p class="text-sm font-mono text-slate-400 mt-1">PROFESSIONAL ROLES & EDUCATION HISTORY</p>
        </div>

        <div class="relative border-l-2 border-[#00F0FF]/30 ml-4 sm:ml-6 pl-6 sm:pl-8 space-y-8">
            @foreach (var item in experiences.OrderBy(e => e.DisplayOrder))
            {
                <div class="relative group">
                    <!-- Timeline Dot -->
                    <div class="absolute -left-[31px] sm:-left-[39px] top-1.5 w-4 h-4 rounded-full bg-[#05070B] border-2 border-[#00F0FF] group-hover:bg-[#00F0FF] transition-all shadow-[0_0_10px_rgba(0,240,255,0.6)]"></div>

                    <div class="glass-panel p-6 rounded-2xl border border-[#00F0FF]/20 hover:border-[#00F0FF]/50 transition-all">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
                            <h3 class="text-lg font-bold text-white font-sans">@item.RoleOrDegree</h3>
                            <span class="text-xs font-mono text-[#00F0FF] px-2.5 py-0.5 rounded-full bg-[#111A2E] border border-[#00F0FF]/30 w-fit">
                                @item.Period
                            </span>
                        </div>
                        <div class="text-sm font-mono text-slate-300 font-medium mb-3">
                            @item.Organization
                        </div>
                        <p class="text-slate-400 text-sm leading-relaxed">
                            @item.Description
                        </p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- ========================================== -->
    <!-- CONTACT SECTION                            -->
    <!-- ========================================== -->
    <section id="contact" class="py-16">
        <div class="glass-panel rounded-3xl p-8 sm:p-12 border border-[#00F0FF]/30 shadow-[0_0_35px_rgba(0,240,255,0.12)]">
            <div class="max-w-2xl mx-auto text-center mb-8">
                <span class="text-xs font-mono text-[#00F0FF] uppercase tracking-widest font-semibold">GET IN TOUCH</span>
                <h2 class="text-3xl font-extrabold text-white mt-2">Initialize Conversation</h2>
                <p class="text-slate-400 text-sm mt-2">Have a project, role, or architecture challenge? Leave a message below.</p>
            </div>

            @if (messageSent)
            {
                <div class="max-w-xl mx-auto p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/40 text-emerald-400 text-center font-mono text-sm">
                    ✓ Message received! I will review and reply to your inbox shortly.
                </div>
            }
            else
            {
                <EditForm Model="@contactModel" OnValidSubmit="HandleContactSubmit" class="max-w-xl mx-auto space-y-4">
                    <DataAnnotationsValidator />

                    <div>
                        <label class="block text-xs font-mono text-slate-300 mb-1">YOUR NAME</label>
                        <input @bind="contactModel.SenderName" required placeholder="Jane Doe"
                               class="w-full px-4 py-2.5 rounded-xl bg-[#111A2E] text-white border border-[#00F0FF]/25 focus:border-[#00F0FF] focus:outline-none focus:ring-1 focus:ring-[#00F0FF] text-sm font-mono transition-all" />
                    </div>

                    <div>
                        <label class="block text-xs font-mono text-slate-300 mb-1">YOUR EMAIL</label>
                        <input @bind="contactModel.SenderEmail" type="email" required placeholder="jane@example.com"
                               class="w-full px-4 py-2.5 rounded-xl bg-[#111A2E] text-white border border-[#00F0FF]/25 focus:border-[#00F0FF] focus:outline-none focus:ring-1 focus:ring-[#00F0FF] text-sm font-mono transition-all" />
                    </div>

                    <div>
                        <label class="block text-xs font-mono text-slate-300 mb-1">MESSAGE</label>
                        <textarea @bind="contactModel.Message" rows="4" required placeholder="Let's build something extraordinary..."
                                  class="w-full px-4 py-2.5 rounded-xl bg-[#111A2E] text-white border border-[#00F0FF]/25 focus:border-[#00F0FF] focus:outline-none focus:ring-1 focus:ring-[#00F0FF] text-sm font-mono transition-all"></textarea>
                    </div>

                    <button type="submit" disabled="@isSubmitting"
                            class="w-full py-3 rounded-xl bg-[#00F0FF] text-[#05070B] font-bold font-mono text-sm hover:bg-[#00F0FF]/90 transition-all shadow-[0_0_20px_rgba(0,240,255,0.3)] disabled:opacity-50">
                        @(isSubmitting ? "TRANSMITTING..." : "SEND TRANSMISSION")
                    </button>
                </EditForm>
            }
        </div>
    </section>
}

@code {
    private ProfileSettings? profile;
    private List<ProjectItem> projects = new();
    private List<SkillItem> skills = new();
    private List<ExperienceItem> experiences = new();
    private List<string> allTags = new();
    private string? selectedTag;

    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool messageSent = false;
    private ContactMessage contactModel = new();

    private IEnumerable<ProjectItem> FilteredProjects =>
        string.IsNullOrEmpty(selectedTag)
            ? projects
            : projects.Where(p => p.TechTags.Any(t => string.Equals(t, selectedTag, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            profile = await PortfolioService.GetProfileAsync();
            projects = await PortfolioService.GetProjectsAsync();
            skills = await PortfolioService.GetSkillsAsync();
            experiences = await PortfolioService.GetExperiencesAsync();

            allTags = projects
                .SelectMany(p => p.TechTags)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Take(6)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading home data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleContactSubmit()
    {
        isSubmitting = true;
        try
        {
            await PortfolioService.SendMessageAsync(contactModel);
            messageSent = true;
            contactModel = new();
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
